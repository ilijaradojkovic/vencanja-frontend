# Product configuration for apps/web (names only, no secrets).
# Local development values are generated by `npm run dev:bootstrap` into
# apps/web/.env.local, which is git-ignored. Names and ownership are documented in
# docs/mvp/ENVIRONMENT.md.

# Supabase (browser + server; never put the service-role key in NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
APP_URL=http://localhost:3000

# Email (local SMTP points at the Supabase CLI mailbox; no real delivery)
EMAIL_DRIVER=smtp
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM=Uspomena <noreply@uspomena.local>
RESEND_API_KEY=
SUPABASE_AUTH_HOOK_SECRET=

# Limits and defaults
RETENTION_MONTHS_DEFAULT=3
EVENT_STORAGE_LIMIT_MB_DEFAULT=50
MAX_UPLOAD_MB=30
CRON_SECRET=

# Observability and diagnostics
METRICS_ENABLED=true
METRICS_TOKEN=
DIAGNOSTICS_ENABLED=true
NEXT_PUBLIC_DIAGNOSTICS_ENABLED=true

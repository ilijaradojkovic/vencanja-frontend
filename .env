# Zajedničko za sve režime (development, production, demo)

# true = aplikacija koristi mock backend iz src/mock (podaci u localStorage)
# false = svi zahtevi idu na VITE_API_BASE_URL
VITE_USE_MOCK=true

# hash = linkovi oblika /#/i/token (statički hosting bez server rewrite pravila)
# browser = čisti linkovi /i/token (potreban fallback na index.html na serveru)
VITE_ROUTER=browser

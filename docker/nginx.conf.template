server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # upload fotografija gostiju
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---------- backend ----------
    # Upstream je u promenljivoj → nginx ga razrešava tek pri zahtevu,
    # pa se kontejner podiže i kad backend (još) nije dostupan (npr. mock build).
    location ~ ^/api/(.*)$ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        set $api_upstream ${API_UPSTREAM};

        proxy_pass $api_upstream/$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
    }

    # ---------- statika ----------
    # fajlovi sa hash-om u imenu (Vite build) – keširaju se zauvek
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html se nikad ne kešira, da korisnici odmah dobiju novu verziju
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback – /i/:token, /app/gosti… vraćaju index.html, React Router preuzima
    location / {
        try_files $uri $uri/ /index.html;
    }
}
